{
  "name": "file-service",
  "version": "1.0.1",
  "description": "",
  "keywords": [
    "loopback-application",
    "loopback"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "14 || 16 || 17 || 18 || 19 || 20 || 21"
  },
  "scripts": {
    "build": "lb-tsc",
    "build:watch": "lb-tsc --watch",
    "lint": "yarn run eslint && yarn run prettier:check",
    "lint:fix": "yarn run eslint:fix && yarn run prettier:fix",
    "prettier:cli": "lb-prettier \"**/*.ts\" \"**/*.js\"",
    "prettier:check": "yarn run prettier:cli -l",
    "prettier:fix": "yarn run prettier:cli --write",
    "eslint": "lb-eslint --report-unused-disable-directives .",
    "eslint:fix": "yarn run eslint --fix",
    "pretest": "yarn run rebuild",
    "test": "lb-mocha --allow-console-logs \"dist/__tests__\"",
    "posttest": "yarn run lint",
    "test:dev": "lb-mocha --allow-console-logs dist/__tests__/**/*.js && yarn run posttest",
    "docker:build": "docker build -t file-service .",
    "docker:run": "docker run -p 3000:3000 -d file-service",
    "premigrate": "yarn run build",
    "migrate": "node ./dist/migrate",
    "preopenapi-spec": "yarn run build",
    "openapi-spec": "node ./dist/openapi-spec",
    "prestart": "yarn run rebuild",
    "start": "node -r source-map-support/register .",
    "clean": "lb-clean dist *.tsbuildinfo .eslintcache",
    "rebuild": "yarn run clean && yarn run build"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "",
  "license": "",
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "dependencies": {
    "@loopback/authentication": "^11.0.0",
    "@loopback/authentication-jwt": "^0.15.0",
    "@loopback/boot": "^7.0.0",
    "@loopback/core": "^6.0.0",
    "@loopback/repository": "^7.0.0",
    "@loopback/rest": "^14.0.0",
    "@loopback/rest-explorer": "^7.0.0",
    "@loopback/service-proxy": "^7.0.0",
    "amqplib": "^0.10.3",
    "dotenv": "^16.0.0",
    "express-session": "^1.17.2",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^3.1.2",
    "keycloak-connect": "^18.0.0",
    "loopback-connector-mongodb": "^6.2.0",
    "loopback-connector-rest": "^5.0.0",
    "mime": "^4.0.1",
    "multer": "^1.4.4",
    "redis": "^4.1.0",
    "tslib": "^2.0.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@loopback/build": "^11.0.0",
    "@loopback/eslint-config": "^15.0.0",
    "@loopback/testlab": "^7.0.0",
    "@types/amqplib": "^0.10.5",
    "@types/express-session": "^1.17.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.18.86",
    "@types/uuid": "^8.3.4",
    "eslint": "^8.57.0",
    "source-map-support": "^0.5.21",
    "typescript": "~5.2.2"
  }
}
