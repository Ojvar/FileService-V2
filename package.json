{
  "name": "file-service",
  "version": "2.1.17",
  "description": "file-service",
  "keywords": [
    "loopback-application",
    "loopback"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "lb-tsc",
    "build:watch": "lb-tsc --watch",
    "lint": "yarn run eslint && yarn run prettier:check",
    "lint:fix": "yarn run eslint:fix && yarn run prettier:fix",
    "prettier:cli": "lb-prettier \"**/*.ts\" \"**/*.js\"",
    "prettier:check": "yarn run prettier:cli -l",
    "prettier:fix": "yarn run prettier:cli --write",
    "eslint": "lb-eslint --report-unused-disable-directives .",
    "eslint:fix": "yarn run eslint --fix",
    "pretest": "yarn run rebuild",
    "test": "lb-mocha --allow-console-logs \"dist/__tests__\"",
    "posttest": "yarn run lint",
    "test:dev": "lb-mocha --allow-console-logs dist/__tests__/**/*.js && yarn run posttest",
    "docker:build": ". ./docker-build.sh",
    "docker:run": "docker run -p 3000:80 -d file-service:$(npm pkg get version | xargs echo)",
    "premigrate": "yarn run build",
    "migrate": "node ./dist/migrate",
    "preopenapi-spec": "yarn run build",
    "openapi-spec": "node ./dist/openapi-spec",
    "prestart": "yarn run rebuild",
    "start": "node -r source-map-support/register .",
    "clean": "lb-clean dist *.tsbuildinfo .eslintcache",
    "rebuild": "yarn run clean && yarn run build",
    "postinstall": "husky install",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "dependencies": {
    "@loopback/boot": "^8.0.16",
    "@loopback/cli": "^7.0.17",
    "@loopback/context": "^8.0.15",
    "@loopback/core": "^7.0.15",
    "@loopback/cron": "^0.13.15",
    "@loopback/repository": "^8.0.15",
    "@loopback/rest": "^15.0.16",
    "@loopback/rest-explorer": "^8.0.16",
    "@loopback/service-proxy": "^8.0.15",
    "bson": "^4.7.0",
    "dotenv": "^16.0.2",
    "jssha": "^3.3.0",
    "keycloak-connect": "^20.0.2",
    "loopback-connector-mongodb": "^5.2.3",
    "loopback-connector-rest": "^4.0.2",
    "multer": "^1.4.5-lts.1",
    "redis": "^4.3.1",
    "tslib": "^2.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@loopback/build": "^12.0.15",
    "@loopback/eslint-config": "^16.0.1",
    "@loopback/testlab": "^8.0.15",
    "@types/base32-encoding": "^1.0.2",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/multer": "^1.4.7",
    "@types/node": "^24.0.0",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^8.3.4",
    "eslint": "^8.57.1",
    "husky": "^8.0.0",
    "pinst": "^3.0.0",
    "source-map-support": "^0.5.21",
    "typescript": "^5.7.0"
  }
}
