NODE_TLS_REJECT_UNAUTHORIZED=0
NODE_ENV=development

# Server
BASE_PATH=
HTTPS=false
SSL_KEY=
SSL_CERT=

REDIS_URL=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_NAME=
REDIS_DATABASE=0
REDIS_SOCKET_HOST=localhost
REDIS_SOCKET_PORT=6379

RABBITMQ_PROTOCOL=amqp
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

FILE_STORAGE_DB_URL=
FILE_STORAGE_DB_HOST=localhost
FILE_STORAGE_DB_PORT=27017
FILE_STORAGE_DB_USER=
FILE_STORAGE_DB_PASSWORD=
FILE_STORAGE_DB_DATABASE=file_storage_db

REQUEST_EXPIRE_MILISECONDS=900000

# 2MB
MULTER_MAX_FILE_SIZE=16384
